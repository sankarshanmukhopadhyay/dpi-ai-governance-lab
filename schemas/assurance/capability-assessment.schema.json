{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sankarshanmukhopadhyay.github.io/dpi-ai-governance-lab/schemas/assurance/capability-assessment.schema.json",
  "title": "TRACE Capability Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment_id", "subject", "artifact_baseline", "evaluated_at", "requirement_results", "evidence", "overall", "residual_risk"],
  "properties": {
    "assessment_id": {"type": "string", "pattern": "^ASMT-[A-Z0-9-]+$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "capability_id", "profile_id", "scope"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "capability_id": {"type": "string", "pattern": "^CAP-[A-Z0-9-]+$"},
        "profile_id": {"type": "string", "pattern": "^CAP-[A-Z0-9-]+-[0-9]+$"},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "artifact_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "interface_version"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "interface_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
      }
    },
    "evaluated_at": {"type": "string", "format": "date-time"},
    "requirement_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "result", "evidence"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "indeterminate", "not_evaluated"]},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "ref"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "class": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "overall": {"enum": ["pass", "fail", "partial", "indeterminate", "not_evaluated"]},
    "residual_risk": {"type": "array", "items": {"type": "string"}}
  }
}
